/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    sanger-tol/ensemblrepeatdownload Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Files are often missing and added later by Ensembl. Since the pipeline won't
    // create partial disks, no need to complain
    withName: 'ENSEMBL_GENOME_DOWNLOAD' {
        errorStrategy = { task.exitStatus in [130,143,137,104,134,139] ? 'retry' : 'ignore' }
    }

    // Most of the pipeline requires very little resources
    cpus   = 1
    // but still gradually increase the resources to allow the pipeline to self-heal
    memory = { 50.MB * task.attempt }
    time   = { 30.min * task.attempt }

    // tabix needs pointers to the sequences in memory
    withName: '.*:.*:PREPARE_REPEATS:TABIX_TABIX_.*' {
        // 50 MB per 25,000 sequences
        memory = { 50.MB * task.attempt * Math.ceil(meta.n_sequences / 25000) }
    }

    // samtools dict loads entire sequences in memory
    withName: 'SAMTOOLS_DICT' {
        // 50 MB per 50 Mbp
        memory = { 50.MB + 50.MB * task.attempt * Math.ceil(meta.max_length / 50000000) }
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }
}
